{
  "name": "medcalculo",
  "version": "1.0.0",
  "private": true,
  "description": "MedCálculo: calculadoras e escores médicos em português",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "catalogo": "node scripts/generate-index.mjs",
    "test": "node scripts/generate-index.mjs && tsc --noEmit && node scripts/smoke-test.mjs && node scripts/golden-test.mjs && node scripts/regression-test.mjs",
    "test:referencias": "node scripts/check-references.mjs",
    "instantaneo": "node scripts/regression-test.mjs --atualizar"
  },
  "dependencies": {
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
